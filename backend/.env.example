# Backend Environment Variables
# Copy this file to .env for local development
# For Render deployment, set these in Render dashboard

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration - Supabase
DB_USER=postgres.YOUR_PROJECT_REF
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_NAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_PORT=5432
DB_SSL=true

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_JWT_SECRET=your-super-secret-admin-key-change-in-production

# Email Configuration (SendGrid - Free 100 emails/day)
# Sign up at https://signup.sendgrid.com/
# Get API key from Settings → API Keys
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=YOUR_SENDGRID_API_KEY
EMAIL_FROM=your-verified-email@gmail.com

# Application URLs
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=admin@ethiobridge.et
ADMIN_PASSWORD=your-admin-password

# ML Recommendation Service (optional)
ML_SERVICE_URL=http://localhost:8000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Chapa Payment Gateway
# Sign up at https://dashboard.chapa.co/
# Get your secret key from Settings → API Keys
CHAPA_SECRET_KEY=YOUR_CHAPA_SECRET_KEY

# Cloudinary (optional — fallback if Supabase Storage not configured)
# Sign up free at https://cloudinary.com and get these from your dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Storage (RECOMMENDED — same project as your database)
# Get from: Supabase Dashboard → Settings → API
# SUPABASE_URL is the same as your database project URL
# SUPABASE_SERVICE_ROLE_KEY is under "service_role" (keep secret!)
# Required buckets: product-images, profile-images, id-documents (set to public)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
